{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist/api",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["packages/config/src/*"],
      "@shared/*": ["packages/shared/src/*"]
    }
  },
  "include": [
    "api/**/*",
    "apps/api/src/**/*",
    "packages/config/src/**/*",
    "packages/shared/src/**/*",
    "prisma/**/*"
  ]
}
