{
  "name": "beat-store-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx apps/api/src/server.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run bot\"",
    "dev:web": "vite --port 5173 --host",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "build:web": "npx vite build",
    "build:api": "npx tsc -p tsconfig.api.json",
    "build": "npx prisma generate && npx vite build",
    "preview": "npx vite preview --host --port 4173",
    "vercel-build": "npx prisma generate && npx vite build",
    "tunnel": "npx cloudflared tunnel --url http://localhost:5173",
    "deploy": "tsx scripts/deploy-git.ts",
    "update-urls": "node scripts/replace-store-urls.mjs",
    "check-placeholders": "tsx scripts/check-placeholders.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "bot": "tsx scripts/whatsapp-bot.ts",
    "yt:auth": "tsx scripts/yt-cli.ts auth",
    "yt:seo": "tsx scripts/yt-cli.ts test-seo",
    "insta:status": "tsx scripts/instagram-cli.ts status",
    "insta:reel": "tsx scripts/instagram-cli.ts reel"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@prisma/client": "^5.21.1",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/rapier": "^1.5.0",
    "@tanstack/react-query": "^5.59.0",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^178.0.0",
    "gsap": "^3.12.5",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.453.0",
    "meshline": "^3.3.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "razorpay": "^2.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.0",
    "prisma": "^5.21.1",
    "vite": "^5.4.8",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "@vitejs/plugin-react": "^4.3.2",
    "tailwindcss": "^3.4.14",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "concurrently": "^9.0.1",
    "vitest": "^2.1.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
